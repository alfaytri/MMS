# ============================================================================
# MMS Inventory Staging — Environment Variables
# ============================================================================
# Copy this file to .env.local and fill in the values from your Supabase
# staging project dashboard (Settings → API).
#
# Staging project ref: mwvblpgbgxipvrevkeff
# Dashboard: https://supabase.com/dashboard/project/mwvblpgbgxipvrevkeff
# ============================================================================

# ── Supabase (Required) ─────────────────────────────────────────────────────
# Source: Supabase Dashboard → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://mwvblpgbgxipvrevkeff.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ── App URL (Required) ──────────────────────────────────────────────────────
# The public URL where the staging app is hosted (used for payment callbacks,
# PDF links, and webhook URLs). Use ngrok URL for local dev.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ── Admin Bootstrap (Required) ──────────────────────────────────────────────
# Email of the first admin user — bypasses RBAC until roles are assigned.
# Server-side (middleware + admin layout):
ADMIN_BOOTSTRAP_EMAIL=m.ismail@alfaytri.com
# Client-side (permissions hook — must match the value above):
NEXT_PUBLIC_ADMIN_BOOTSTRAP_EMAIL=m.ismail@alfaytri.com

# ── Module Gate (Optional) ──────────────────────────────────────────────────
# Comma-separated list of enabled modules. Omit to show all modules.
# Valid keys: master_data, purchase_sales, warehouse, orders, contracts,
#             finance, teams, reports, system, contact_centre
# For inventory staging, restrict to only the relevant modules:
NEXT_PUBLIC_ENABLED_MODULES=master_data,purchase_sales,warehouse,finance,reports

# ── Dibsy Payment Gateway (Required for payment flows) ──────────────────────
# Source: Dibsy merchant dashboard
DIBSY_SECRET_KEY=
NEXT_PUBLIC_DIBSY_PUBLIC_KEY=
DIBSY_MERCHANT_ID=

# ── Cron / Background Jobs (Optional) ───────────────────────────────────────
# Shared secret for cron-triggered API routes (booking confirmations, purge).
# Set to any random string. Leave empty to disable cron auth.
CRON_SECRET=

# ============================================================================
# EXCLUDED — Not needed for inventory staging
# ============================================================================
# The following are used by modules excluded from the staging build.
# Leave them empty or remove entirely. The app handles missing values
# gracefully (defaults to '' via ?? '').
#
# ── Contact Centre (Wati WhatsApp) ──────────────────────────────────────────
# WATI_API_URL=
# WATI_API_TOKEN=
# WATI_WEBHOOK_SECRET=
#
# ── Contact Centre (Whapi) ──────────────────────────────────────────────────
# WHAPI_TOKEN=
# WHAPI_WEBHOOK_SECRET=
#
# ── Contact Centre (3CX PBX) ───────────────────────────────────────────────
# 3CX_PBX_URL=
# 3CX_CLIENT_ID=
# 3CX_CLIENT_SECRET=
# 3CX_WEBHOOK_SECRET=
#
# ── Shipment Tracking (17track) ─────────────────────────────────────────────
# SEVENTEEN_TRACK_API_KEY=
# SEVENTEEN_TRACK_WEBHOOK_SECRET=
#
# ── Vehicle Tracking (Traccar) ──────────────────────────────────────────────
# TRACCAR_API_URL=
# TRACCAR_EMAIL=
# TRACCAR_PASSWORD=
#
# ── Booking Confirmations ──────────────────────────────────────────────────
# BOOKING_CONFIRMATION_PDF_URL=
